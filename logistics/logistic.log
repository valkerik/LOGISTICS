    p_shipment_id BIGINT,
    p_new_status  shipment_status,
    p_note        TEXT DEFAULT NULL,
    p_user_id     BIGINT DEFAULT NULL
)
LANGUAGE plpgsql
AS $$
DECLARE
    v_old_status shipment_status;
BEGIN
    SELECT status INTO v_old_status FROM shipment WHERE id = p_shipment_id FOR UPDATE;
    IF v_old_status IS NULL THEN
        RAISE EXCEPTION 'Shipment % not found', p_shipment_id;
    END IF;

    IF v_old_status = 'NEW'        AND p_new_status NOT IN ('ASSIGNED','CANCELLED') THEN
        RAISE EXCEPTION 'Invalid transition: % -> %', v_old_status, p_new_status;
    ELSIF v_old_status = 'ASSIGNED' AND p_new_status NOT IN ('PICKED_UP','CANCELLED') THEN
        RAISE EXCEPTION 'Invalid transition: % -> %', v_old_status, p_new_status;
    ELSIF v_old_status = 'PICKED_UP' AND p_new_status NOT IN ('IN_TRANSIT','CANCELLED') THEN
        RAISE EXCEPTION 'Invalid transition: % -> %', v_old_status, p_new_status;
    ELSIF v_old_status = 'IN_TRANSIT' AND p_new_status NOT IN ('DELIVERED','CANCELLED') THEN
        RAISE EXCEPTION 'Invalid transition: % -> %', v_old_status, p_new_status;
    ELSIF v_old_status IN ('DELIVERED','CANCELLED') THEN
        RAISE EXCEPTION 'Shipment already in terminal status: %', v_old_status;
    END IF;

    UPDATE shipment SET status = p_new_status WHERE id = p_shipment_id;

    INSERT INTO shipment_status_history (shipment_id, status, note, changed_by)
    VALUES (p_shipment_id, p_new_status, COALESCE(p_note, 'Advanced via procedure'), p_user_id);
END$$]
