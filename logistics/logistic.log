INSERT INTO vehicle (carrier_id, plate_no, vin, make, model, year, capacity_kg, type, active, created_at)
SELECT c.id, v.plate_no, v.vin, v.make, v.model, v.year, v.capacity_kg, v.type, v.active, now()
FROM (
  VALUES
    ('FastCarrier', 'A111AA77', 'VF1ABCD1234567890', 'Volvo',   'FH',   2018, 20000.00, 'TRUCK', true),
    ('Рогачев', 'A222AA31', 'VF1ABCD1234561111', 'BMW',   'FH',   2018, 20000.00, 'TRUCK', true),
    ('ИП Печенька', 'A333AA77', 'VF1ABCD1234567333', 'Kamaz',   'FH',   2021, 20000.00, 'TRUCK', true),
    ('ИП Печенька', 'А444AA77', 'VF1ABCD1234564444', 'Van',   'FH',   2011, 22000.00, 'TRUCK', true),
    ('Рогачев', 'A111AA77', 'VF1ABCD1234567890', 'Gazel',   'FH',   2020, 5000.00, 'TRUCK', true),
    ('Сорти', 'A111AA77', 'VF1ABCD1234567770', 'Volvo',   'FH',   2019, 23000.00, 'TRUCK', true),
    ('FastCarrier', 'B222BB77', 'WDBXYZ98765432100', 'Mercedes','Actros',2022, 12000.00, 'TRUCK', true),
