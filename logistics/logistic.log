INSERT INTO shipment
  (client_id, carrier_id, vehicle_id, driver_id,
   pickup_address, delivery_address,
   cargo_description, cargo_weight,
   planned_pickup_at, planned_delivery_at,
   price, status, created_at, updated_at)
SELECT
  cl.id, cr.id, v.id, dr.id,
  s.pickup_address, s.delivery_address,
  s.cargo_description, s.cargo_weight,
  now() + s.pickup_shift, now() + s.delivery_shift,
  s.price, s.status, now(), now()
FROM (
  VALUES
    
    ('ACME Logistics LLC', 'FastCarrier', 'A111AA77', '77 11 123456', 'Москва, Склад 1',      'Тверь, Магазин 5',      'Паллеты 33Е',       18000.00, interval '1 day', interval '2 days', 120000.00, 'ASSIGNED'),
    ('Globex Import',      'FastCarrier', 'B222BB77', '77 22 234567', 'СПб, Терминал Сев',    'Великий Новгород, ТЦ',  'Стройматериалы',     20000.00, interval '2 days', interval '4 days', 150000.00, 'NEW'),
    ('Soyuz Agro',         'EuroCarrier', 'C333CC98', '98 33 345678', 'Новосибирск, Элеватор','Барнаул, АгроБаза',     'Семена подсолнеч.',   3200.00, interval '12 hours', interval '36 hours',  65000.00, 'IN_TRANSIT')
) AS s(client_name, carrier_name, plate_no, driver_license, pickup_address, delivery_address, cargo_description, cargo_weight, pickup_shift, delivery_shift, price, status)
JOIN client  cl ON cl.name = s.client_name
JOIN carrier cr ON cr.name = s.carrier_name
LEFT JOIN vehicle v ON v.plate_no = s.plate_no
LEFT JOIN driver  dr ON dr.license_number = s.driver_license

ON CONFLICT DO NOTHING;



INSERT INTO shipment_status_history (shipment_id, status, changed_at, changed_by, note)
SELECT s.id, s.status, s.created_at, NULL, 'seed: initial'
FROM shipment s
